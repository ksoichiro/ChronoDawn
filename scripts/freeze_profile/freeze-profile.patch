+package com.chronodawn.freezeprofile;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/** Measurement-only helper, applied by scripts/freeze_profile/freeze-profile.patch. Not part of the mod. */
+public final class FreezeProfile {
+    private static final String MODE = System.getProperty("chronodawn.freezeProfile", "on");
+    /** "off": both handlers disabled (vanilla). */
+    public static final boolean OFF = "off".equals(MODE);
+    /** "headonly": only the HEAD skip runs, the RETURN snow transition is disabled. */
+    public static final boolean HEAD_ONLY = "headonly".equals(MODE);
+    private static final AtomicInteger PENDING = new AtomicInteger();
+    private static final ConcurrentLinkedQueue<String> LINES = new ConcurrentLinkedQueue<>();
+    private static final Path OUT = Path.of(System.getProperty("chronodawn.freezeProfile.out",
+            "freeze-profile-" + ProcessHandle.current().pid() + ".csv"));
+
+    static {
+        if (!OFF) {
+            Runtime.getRuntime().addShutdownHook(new Thread(FreezeProfile::flush));
+        }
+    }
+
+    private FreezeProfile() {
+    }
+
+    public static void record(String line) {
+        LINES.add(System.nanoTime() + "," + Thread.currentThread().getName() + "," + line);
+        if (PENDING.incrementAndGet() > 2000) {
+            flush();
+        }
+    }
+
+    private static synchronized void flush() {
+        PENDING.set(0);
+        StringBuilder sb = new StringBuilder();
+        String line;
+        while ((line = LINES.poll()) != null) {
+            sb.append(line).append('\n');
+        }
+        if (sb.length() == 0) {
+            return;
+        }
+        try {
+            Files.writeString(OUT, sb, StandardOpenOption.CREATE, StandardOpenOption.APPEND);
+        } catch (IOException e) {
+            e.printStackTrace();
+        }
+    }
+}
